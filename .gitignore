# Local PDF storage / downloaded data (backend).
# Never commit downloaded third-party papers (size + license/rehosting concerns);
# the ingest jobs re-fetch them. Keep the folder, ignore its contents.
backend/uploads/*
!backend/uploads/.gitkeep
backend/papers/
backend/data/

