# ── Green Occasion JMS portal — environment ──
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
NODE_ENV=production
PORT=3001

# ── Postgres ──
DB_USER=greenocc
DB_PASSWORD=change_me_strong_password
DB_NAME=greenocc_library
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL=false

# ── Job execution ──
# inline = run jobs in-process (Postgres + Node only, no Redis). Recommended.
# bullmq = enqueue to Redis and run a separate `npm run worker` process.
JOB_RUNNER=inline

# ── Admin bootstrap (first run creates this admin if no users exist) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ── Providers ──
# OpenAlex needs no key (mailto = polite pool). Semantic Scholar key = 1 req/sec.
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key
# Unpaywall resolves verified open-access PDF links by DOI (requires an email).
UNPAYWALL_EMAIL=you@example.com

# ── Google Gemini (AI summaries, highlights, classification) ──
GOOGLE_GENAI_API_KEY=your_genai_api_key
GENAI_MODEL=gemini-2.5-flash

# ── PDF storage (local disk for the minimal stack) ──
PDF_STORAGE_DIR=./backend/uploads

# Admin "View Public Site" links -> the public site URL (the separate web/ project).
# Dev: the public app's dev server. Prod: your public site URL.
VITE_PUBLIC_SITE_URL=http://localhost:3000
