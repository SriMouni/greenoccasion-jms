# Caddy — automatic HTTPS (Let's Encrypt) for the whole platform on one box.
#
#   thecarbonreview.org       -> the public reading site (static SPA, built from ../web)
#   jms.thecarbonreview.org   -> the JMS backend: API (/api, /uploads) + admin UI
#
# DNS: point A records for @, www, and jms at this VM's public IP, and open ports
# 80 + 443 in the OCI cloud firewall (VCN > Security List > Ingress).
#
# The public SPA is built with VITE_API_BASE_URL=https://jms.thecarbonreview.org and
# its dist/ copied to /var/www/carbonreview (see AWS_MIGRATION_PLAN.md, Phase 4).

thecarbonreview.org, www.thecarbonreview.org {
    root * /var/www/carbonreview
    encode gzip
    try_files {path} /index.html
    file_server
}

jms.thecarbonreview.org {
    reverse_proxy localhost:3001
}
